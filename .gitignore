node_modules/
frontend/dist/

# ─── Generated data ────────────────────────────────────────────
# All of this is reproducible from scripts/ and preprocessing/, and a single
# file (hyderabad_drive.graphml, 575 MB) is far beyond GitHub's 100 MB limit.
# Rebuild with:
#   bash scripts/fetch_benchmarks.sh
#   python preprocessing/osm_processor.py --city "Hyderabad, Telangana, India" --metro
#   python scripts/run_traffic.py --all --save
data/raw/benchmarks/
data/raw/osm/
data/vision/
*.graphml
*.pkl
*.h5
*.parquet
*.npy

# Keep: small, hand-curated, or NOT reproducible. The TomTom series in
# particular cannot be re-downloaded — it accrues in wall-clock time.
!data/raw/india/hyderabad_segments.csv
!data/raw/india/tomtom_*/**
!data/processed/*/*_stats.json
!results/**

.vercel
.env*

# Training artifacts. The bulky, reproducible ones stay out; the two trained
# models the API actually loads at runtime stay in, because without them
# /forecast and /vision both return 503 for anyone who clones this.
#
# Git cannot re-include a file whose parent directory is excluded, so the YOLO
# run is excluded level by level and the pieces worth keeping are named.
results/yolo/*
!results/yolo/dats_v8n/
results/yolo/dats_v8n/*
!results/yolo/dats_v8n/results.csv
!results/yolo/dats_v8n/args.yaml
!results/yolo/dats_v8n/weights/
results/yolo/dats_v8n/weights/*
!results/yolo/dats_v8n/weights/best.pt
results/lstm/*.pt
yolov8n.pt
