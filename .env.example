# ─── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=smartroute

# ─── CORS (comma-separated origins) ───────────────────────────
# Every origin the browser may call this API from, comma separated.
# A deployed frontend calls from its https origin, so that must be listed
# or the browser blocks every request while the API looks healthy to curl.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://q-route.vercel.app

# ─── Application ───────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# ─── Natural-language route assistant (server-side only) ──────
# The frontend never receives this key. Any OpenAI-compatible gateway works.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# ─── Google sign-in ───────────────────────────────────────────
# OAuth client ID (Web application) from Google Cloud Console. Public, not a
# secret; the frontend reads it from /api/auth/config. Its "Authorized
# JavaScript origins" must include http://localhost:5173 and any deployed URL.
GOOGLE_CLIENT_ID=

# ─── Sessions and admins ──────────────────────────────────────
# Signs the session token every signed-in request carries. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty, a random key is used per run and everyone is signed out on restart.
SESSION_SECRET=
# Google accounts that are admins, comma-separated. Only Google sign-in reads
# this (Google has verified the email). Password admins: scripts/create_admin.py
ADMIN_EMAILS=
