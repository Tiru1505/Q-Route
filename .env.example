# ─── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=smartroute

# ─── CORS (comma-separated origins) ───────────────────────────
# Every origin the browser may call this API from, comma separated.
# A deployed frontend calls from its https origin, so that must be listed
# or the browser blocks every request while the API looks healthy to curl.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://q-route.vercel.app

# ─── Application ───────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# ─── Natural-language route assistant (server-side only) ──────
# The frontend never receives this key. Any OpenAI-compatible gateway works.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# ─── Firebase Cloud Messaging (optional) ──────────────────────
FCM_SERVER_KEY=
