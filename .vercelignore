# Vercel hosts the React app only; the Python side must not be uploaded.
#
# EVERY PATTERN IS ANCHORED WITH A LEADING SLASH, ON PURPose.
# .vercelignore uses gitignore syntax, where an unanchored `data/` matches a
# directory named data at ANY depth. An earlier version of this file listed
# `data/` and silently excluded frontend/src/data/ as well, so the build failed
# with: Could not resolve "../data/mockData" from "src/store/AppContext.jsx".
# A leading slash pins each pattern to the repository root.
#
# This matters for CLI deploys specifically: `vercel deploy` uploads the working
# directory, not what git tracks, so the 214 MB graph pickle in data/processed/
# is picked up unless excluded — and it exceeds Vercel's 100 MB file limit.

/backend/
/data/
/results/
/models/
/notebooks/
/diagrams/
/.venv/
/node_modules/

/render.yaml
/railway.toml
/docker-compose.yml
/Dockerfile
/pytest.ini

# Local env files must not ride along. `vercel deploy` uploads the working
# directory rather than what git tracks, so frontend/.env — gitignored, and set
# to whatever suits local work — was being baked into production builds. The
# project's own environment variables are the single source of truth.
/frontend/.env
/frontend/.env.local
/frontend/.env.*.local
